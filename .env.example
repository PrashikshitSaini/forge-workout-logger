# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── OpenRouter (AI coach) ─────────────────────────────────────────────────────
# Server-side only — never exposed to the browser. https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR-OPENROUTER-KEY
# Any OpenRouter model id. Default is a fast, cheap chat model; change freely.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: model dedicated to nutrition research + structured meal extraction.
# Defaults to Gemini 3 Flash so meal accuracy does not depend on the coach model.
MEAL_LOGGER_MODEL=google/gemini-3-flash-preview

# Optional: used in OpenRouter's dashboard attribution headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Watch sync ingestion (POST /api/health-sync) ─────────────────────────────
# Lets a phone automation (e.g. Tasker reading Health Connect) push daily watch
# metrics — steps, sleep, calories, heart rate. All SERVER-ONLY: the endpoint
# writes with the service-role key, so these must never reach a phone/browser.
#
# Service-role key — Project Settings → API. Bypasses RLS; keep it secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# A long random secret. The automation sends it as: Authorization: Bearer <token>
HEALTH_SYNC_TOKEN=generate-a-long-random-string
# The Supabase auth user id that synced rows belong to (your own account's UUID).
HEALTH_SYNC_USER_ID=your-supabase-user-uuid
# Optional: OpenRouter model used to normalize a messy `raw` payload into clean
# metrics. Defaults to deepseek/deepseek-chat — set to the exact DeepSeek id you
# want. Only used when a payload sends `raw`; structured payloads skip the LLM.
HEALTH_SYNC_MODEL=deepseek/deepseek-chat
